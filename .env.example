# Copy this file to ".env" if you need to change anything. Never commit the real .env.
# install.ps1 writes PORT and FOODLAB_BACKUP_DIR on the mini PC.

# The server's port (dev default 8788; the mini PC uses 8082).
# PORT=8788

# Daily database copies (default: data/backups).
# FOODLAB_BACKUP_DIR=

# The database file (default: data/foodlab.db).
# FOODLAB_DB=
